{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    { "src": "/static/(.*)", "dest": "/static/$1" },
    { "src": "/robots.txt", "dest": "app.py" },
    { "src": "/sitemap.xml", "dest": "app.py" },
    { "src": "/healthz", "dest": "app.py" },
    { "src": "/(.*)", "dest": "app.py" }
  ]
}
